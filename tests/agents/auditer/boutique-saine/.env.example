# Variables d'environnement du site (copier en .env.local et remplir).
# Ne jamais versionner de vraie valeur.

# Clé secrète Stripe (serveur uniquement) : sk_test_… en développement
STRIPE_SECRET_KEY=

# Adresse publique du site, sans / final (ex. https://www.boutique.fr).
# Sert aux retours depuis la page de paiement Stripe.
SITE_URL=
